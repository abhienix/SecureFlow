# Must change
JWT_SECRET=replace_with_a_32_byte_hex_secret_key_here
SECUREFLOW_API_URL=https://your-cloudrun-backend-url.run.app
SECUREFLOW_API_TOKEN=your-secureflow-service-account-token

# Production mode
ENVIRONMENT=production
LOG_LEVEL=INFO

# Default AI Server settings
AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=8100
OLLAMA_URL=http://ollama:11434
MODEL_NAME=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
CHROMADB_PATH=/data/chromadb
